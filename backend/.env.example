# Database Config
DATABASE_URL_ASYNC=postgresql+asyncpg://civic_lantern_user:your_password_here@localhost:5432/civic_lantern_dev
TEST_DATABASE_URL_ASYNC=postgresql+asyncpg://civic_lantern_user:your_password_here@localhost:5432/test_db

# Application Settings
ENVIRONMENT=development
DEBUG=True

# Comma-separated list of origins allowed to call the API (CORS)
ALLOWED_ORIGINS=http://localhost:3000

# Bearer key(s) the API accepts; match frontend/.env.local's BACKEND_API_KEY
API_KEYS=local-dev-key
# Serve /docs, /redoc and /openapi.json (local only; default off)
EXPOSE_DOCS=true

# API Keys
# Get a free FEC API key at https://api.data.gov/signup/
FEC_API_KEY=your_fec_api_key_here
